# ============================================================
#  Copy this file to ".env" and fill in your values.
#    cp .env.example .env         (macOS / Linux)
#    copy .env.example .env       (Windows)
# ============================================================

# --- Anthropic (Claude) — required for LIVE reasoning -------
# Get a key at https://console.anthropic.com/  (starts with "sk-ant-")
# NEVER put your real key in this example file — put it in ".env" instead.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to use for clinical reasoning synthesis.
CLAUDE_MODEL=claude-sonnet-4-5

# --- Model files -------------------------------------------
# Path to your trained CNN weights (relative to project root).
CNN_WEIGHTS_PATH=models/best_model.weights.h5

# Path to the ordered list of 30 class names (see README).
CLASS_NAMES_PATH=class_names.json

# --- Contextual-memory sources -----------------------------
# Enable the real Microsoft BioGPT model (requires: uv sync --extra biogpt).
# If false, a curated biomedical-context fallback is used instead.
ENABLE_BIOGPT=false

# Med-PaLM 2 has no public API. This adapter is a labeled placeholder.
# Leave false unless you have wired real Google MedLM/Med-PaLM access.
ENABLE_MEDPALM=false

# --- Server ------------------------------------------------
HOST=127.0.0.1
PORT=8000
